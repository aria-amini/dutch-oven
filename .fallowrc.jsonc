{
	"entry": [
		// Run by mise and Vitest config, not imported from app code.
		"mise-tasks/bootstrap.ts",
		"mise-tasks/migrate.ts",
		"tests/support/db.global-setup.ts",
		// shadcn library: components stay available before a route imports them
		"src/components/ui/**",
	],
	"rules": {
		// Build tooling (mise tasks, Tailwind CSS import) belongs in devDependencies
		"dev-dependencies-in-production": "off",
	},
}
