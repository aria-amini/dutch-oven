{
	"entry": [
		// Run by mise and Vitest config, not imported from app code.
		"mise-tasks/*.ts",
		"tests/support/db.global-setup.ts",
		// shadcn component library: reachable only from each other until an app route imports them
		"src/components/ui/**",
	],
	"ignoreDependencies": [
		// Build tooling: mise-tasks/ imports execa, styles.css imports shadcn CSS
		"execa",
		"shadcn",
	],
	"rules": {
		// Nitro bundles app code into .output, so packages the app imports are
		// devDependencies. dependencies holds only what runs outside the bundle:
		// varlock for `start`, and drizzle-orm and pg for migrations.
		"dev-dependencies-in-production": "off",
	},
}
