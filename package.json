{
	"name": "dutch-oven",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
		"dev": "vp dev",
		"build": "vp build && cp instrument.server.mjs .output/server",
		"preview": "vp preview",
		"start": "varlock run -- node --import ./.output/server/instrument.server.mjs .output/server/index.mjs",
		"check": "vp check",
		"test": "vp test run --passWithNoTests",
		"test:unit": "vp test run --project unit --passWithNoTests",
		"test:server": "vp test run --project server --passWithNoTests",
		"test:browser": "vp test run --project browser --passWithNoTests",
		"test:update": "vp test run --project browser --update",
		"test:watch": "vp test --watch",
		"test:ui": "vp test dev --ui --open=false --project browser --api.port ${APP_PORT:-5123} --api.strictPort --api.host \"${TAILSCALE_IP:-$(tailscale ip -4 2>/dev/null || echo 127.0.0.1)}\"",
		"e2e": "varlock run -- playwright test",
		"e2e:update": "varlock run -- playwright test --update-snapshots",
		"report": "playwright show-report .playwright/report",
		"compose:up": "docker compose --env-file .env.workspace.local up -d --wait --remove-orphans postgres minio",
		"compose:down": "docker compose --env-file .env.workspace.local down",
		"compose:reset": "docker compose --env-file .env.workspace.local down --volumes --remove-orphans && vp run compose:up",
		"db:push": "varlock run -- drizzle-kit push",
		"db:generate": "varlock run -- drizzle-kit generate",
		"db:migrate": "varlock run -- tsx mise-tasks/migrate.ts",
		"prepare": "vp config --no-hooks",
		"update-pnpm": "corepack use pnpm@12",
		"dead-code": "fallow dead-code",
		"import:fetch": "uv run --locked scripts/import-fetch.py"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1073.0",
		"@aws-sdk/s3-request-presigner": "^3.1073.0",
		"@base-ui/react": "^1.9.0",
		"@better-auth/drizzle-adapter": "^1.6.20",
		"@fontsource-variable/jetbrains-mono": "^5.2.8",
		"@fontsource-variable/open-sans": "^5.3.0",
		"@phosphor-icons/react": "^2.1.10",
		"@posthog/react": "^1.10.3",
		"@remixicon/react": "^4.9.0",
		"@rolldown/plugin-babel": "^0.2.3",
		"@sentry/tanstackstart-react": "^10.69.0",
		"@tanstack/react-query": "5.101.0",
		"@tanstack/react-router": "1.170.18",
		"@tanstack/react-router-devtools": "1.167.0",
		"@tanstack/react-start": "1.168.32",
		"@tanstack/router-plugin": "1.168.18",
		"@varlock/infisical-plugin": "^2.1.0",
		"@vitejs/plugin-react": "^6.0.2",
		"better-auth": "^1.6.20",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"cmdk": "^1.1.1",
		"drizzle-orm": "1.0.0-rc.4",
		"framer-motion": "^12.40.0",
		"nitro": "3.0.260610-beta",
		"pg": "^8.22.0",
		"posthog-js": "^1.391.2",
		"posthog-node": "^5.49.0",
		"react": "^19.2.7",
		"react-dom": "^19.2.7",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.6.0",
		"undici": "^8.10.0",
		"varlock": "^1.14.1",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@aamini/config": "^0.2.0",
		"@playwright/test": "^1.61.0",
		"@shadcn/lint": "^0.2.1",
		"@tailwindcss/vite": "^4.3.1",
		"@tanstack/devtools-vite": "0.8.0",
		"@testcontainers/postgresql": "^12.0.3",
		"@types/node": "^26.1.1",
		"@types/pg": "^8.20.0",
		"@types/react": "^19.2.17",
		"@types/react-dom": "^19.2.3",
		"@varlock/vite-integration": "^1.4.0",
		"@vitest/browser-playwright": "catalog:",
		"@vitest/ui": "catalog:",
		"babel-plugin-react-compiler": "^1.0.0",
		"drizzle-kit": "1.0.0-rc.4",
		"drizzle-seed": "1.0.0-rc.4",
		"execa": "^10.0.1",
		"fallow": "^3.6.0",
		"msw": "^2.14.6",
		"oxlint-plugin-eslint": "^1.73.0",
		"shadcn": "^4.11.0",
		"tailwindcss": "^4.3.1",
		"testcontainers": "^12.0.3",
		"tsx": "^4.22.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"vite": "catalog:",
		"vite-plus": "catalog:",
		"vitest": "catalog:",
		"vitest-browser-react": "^2.2.0"
	},
	"packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
