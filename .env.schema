# https://varlock.dev/env-spec
# ---
# @defaultRequired=infer @defaultSensitive=false
# @currentEnv=$APP_ENV
# @generateTsTypes(path=env.d.ts, importMetaEnv=none)
# @encryptInjectedEnv=forEnv(production)
# @plugin(@varlock/bitwarden-plugin)
# ---

# @type=enum(development, preview, production, test)
APP_ENV=fallback($VARLOCK_ENV, development)
VITE_APP_ENV=$APP_ENV

# @type=port
APP_PORT=3000

# @type=bitwardenAccessToken @sensitive @required=forEnv(production, preview)
BWS_ACCESS_TOKEN=

# @type=url @required
BETTER_AUTH_URL=if(forEnv(development), "http://localhost:${APP_PORT}", "https://dutch-oven-production.up.railway.app")
# @required=forEnv(production, preview) @sensitive
BETTER_AUTH_SECRET=
# Separate from BETTER_AUTH_SECRET so rotating the session-secret doesn't
# invalidate OAuth proxy cookies (and vice versa).
# @required=forEnv(production, preview) @sensitive
OAUTH_PROXY_SECRET=

# @required @type=url @sensitive
DATABASE_URL=

# @required=forEnv(production, preview)
GOOGLE_CLIENT_ID="226948588184-lj4v456ith2npetoadfgu2hqjcjl8i3p.apps.googleusercontent.com"
# @required=forEnv(production, preview) @sensitive
GOOGLE_CLIENT_SECRET=

# @required
AWS_S3_BUCKET_NAME=
# @required
AWS_REGION="us-east-1"
# @required @type=url
AWS_ENDPOINT_URL=
# @required
AWS_ACCESS_KEY_ID=
# @required @sensitive
AWS_SECRET_ACCESS_KEY=

# @required=forEnv(production)
VITE_POSTHOG_PROJECT_TOKEN=
# @required=forEnv(production)
VITE_POSTHOG_HOST=

# @required=forEnv(production)
VITE_PUBLIC_GTM_ID=
# @required=forEnv(production)
VITE_PUBLIC_SENTRY_DSN=
# @required=forEnv(production) @sensitive
SENTRY_AUTH_TOKEN=
