#!/usr/bin/env bash
#MISE description="Bootstrap a fresh clone or jj workspace: tools, deps, docker, database"
set -euo pipefail

cd "$(dirname "$0")/.."

mise install

vp i

# Triggers varlock(prompt) for the Bitwarden token on first run.
vp exec varlock load
if [[ -f .env.local ]]; then
	vp exec varlock encrypt --file .env.local
fi

mise run setup

set -a; source .env.development.local; set +a

vp run compose:up
vp run db:migrate

echo
echo "Bootstrap complete. Run 'vp dev' to start the app."
